#!/bin/bash
# The ONE command the modules container executes: sandbox-modules SECONDS FOLDER   (FOLDER a folder of the project, or -)
# This container has a network and the shared module cache (writable). It runs `go mod download` and nothing else: no build, no test, no program of the
# student's. The code is only unpacked so that its go.mod can be read. No go.mod with requirements, or a vendor folder: nothing to download, and it exits 0.
exec 2>&1
set -u
. "$(dirname -- "${BASH_SOURCE[0]}")/sandbox-common"

[ "$#" -eq 2 ] || refuse 'the call is not complete.'
secs=$1 folder=$2
[[ $secs =~ ^[0-9]{1,3}$ ]] || refuse 'bad time limit.'

stage_code "$folder"
find_gomod || exit 0
grep -Eq '^[[:space:]]*require[[:space:](]' "$GOMOD_DIR/go.mod" || exit 0
[ ! -d "$GOMOD_DIR/vendor" ] || exit 0
cd -- "$GOMOD_DIR" || exit 0
exec timeout -s KILL "$secs" go mod download < /dev/null
