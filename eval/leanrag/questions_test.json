                 [{ "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [12, 14] }, { "deck": "Day1 lecture ONLINE 2026.pdf", "pages": [13] }, { "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [21] }]],
      "must_contain": ["scale up", "scale out", "scale-out", "scaling-up", "scaling-out"] },
    { "id": "T17", "type": "compare", "q": "How does a monolith compare to a microservices architecture?",
      "groups": [[{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [7, 8, 10] }, { "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [10] }],
                 [{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [11, 12, 13, 24] }, { "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [11] }]],
      "must_contain": ["monolith", "microservice"] },

    { "id": "T18", "type": "cross-deck", "q": "Where does the course explain stateless services?",
      "groups": [[{ "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [13] }],
                 [{ "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [22, 27, 38] }]],
      "must_contain": ["stateless"] },
    { "id": "T19", "type": "cross-deck", "q": "How are goroutines different from the OS threads we covered earlier?",
      "groups": [[{ "deck": "Goroutines in brief.pdf", "pages": [2, 10, 11, 12] }],
                 [{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [24] }]],
      "must_contain": ["goroutine", "thread"] },
    { "id": "T20", "type": "cross-deck", "q": "How does the course define scalability?",
      "groups": [[{ "deck": "Day1 lecture ONLINE 2026.pdf", "pages": [8, 9, 11, 18] }],
                 [{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [3] }, { "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [4] }]],
