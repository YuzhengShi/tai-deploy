{
  "set": "test",
  "version": 1,
  "written": "2026-11-11",
  "author": "the LeanRAG build session (a model), from the nine Fall 2026 decks. Written BEFORE any retrieval system was run on it. Not written by the instructor or by students: see docs/LEANRAG.md, 'Validity'. Replace or extend by editing this file and bumping `version`; the harness records the file's hash with every result.",
  "mix": { "lookup": 8, "paraphrase": 5, "compare": 4, "cross-deck": 3 },
  "how_a_question_is_scored": "`groups` is a list; every group must be hit. A group is hit when one of the first k items a system returns covers a (deck, page) listed in it (an item may cover several pages, the stand-in's chunks cover two). lookup/paraphrase have one group; compare has one group per concept; cross-deck has one group per deck.",
  "questions": [
    { "id": "T01", "type": "lookup", "q": "What are the three types of AWS Elastic Load Balancer?",
      "groups": [[{ "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [31] }]],
      "must_contain": ["application load balancer", "network load balancer", "gateway load balancer"] },
    { "id": "T02", "type": "lookup", "q": "What are the two phases of two-phase commit?",
      "groups": [[{ "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [38, 39, 46] }]],
      "must_contain": ["prepare", "commit", "abort"] },
    { "id": "T03", "type": "lookup", "q": "How does the circuit breaker pattern work, and what do open and closed mean?",
      "groups": [[{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [34, 35, 36] }]],
      "must_contain": ["circuit breaker", "open", "closed"] },
    { "id": "T04", "type": "lookup", "q": "What is the cache-aside pattern?",
      "groups": [[{ "deck": "day09-caching.pdf", "pages": [11, 13, 17] }]],
      "must_contain": ["cache-aside"] },
    { "id": "T05", "type": "lookup", "q": "What does the max-age cache-control directive do?",
      "groups": [[{ "deck": "day09-caching.pdf", "pages": [22, 26] }]],
      "must_contain": ["max-age"] },
    { "id": "T06", "type": "lookup", "q": "How do I set up a CloudWatch alarm that fires when my EC2 instance's CPU gets too high?",
      "groups": [[{ "deck": "Observability.pdf", "pages": [10, 12] }]],
      "must_contain": ["alarm", "cpuutilization", "80"] },
    { "id": "T07", "type": "lookup", "q": "How do I make my main function wait until all goroutines finish in Go?",
      "groups": [[{ "deck": "Goroutines in brief.pdf", "pages": [6, 8, 9] }]],
      "must_contain": ["wait", "waitgroup"] },
    { "id": "T08", "type": "lookup", "q": "What are the 8 fallacies of distributed computing?",
      "groups": [[{ "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [6] }]],
      "must_contain": ["fallacies", "network is reliable"] },

    { "id": "T09", "type": "paraphrase", "q": "In a multi-database transaction, what if the boss node goes down right after choosing commit? Are the others stuck waiting?",
