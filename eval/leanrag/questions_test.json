      "must_contain": ["coordinator", "crashes", "uncertainty", "stuck"] },
    { "id": "T10", "type": "paraphrase", "q": "Why does one slow downstream service end up taking down my whole app?",
      "groups": [[{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [26, 27, 28, 29] }]],
      "must_contain": ["slow", "cascading", "threads"] },
    { "id": "T11", "type": "paraphrase", "q": "My server remembers who each user is between requests. Why does that make it hard to add more servers behind a load balancer?",
      "groups": [[{ "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [21, 36, 38] }, { "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [13] }]],
      "must_contain": ["stateful", "session", "load balancer"] },
    { "id": "T12", "type": "paraphrase", "q": "How can a cache check that its stored copy is still up to date without downloading the whole thing again?",
      "groups": [[{ "deck": "day09-caching.pdf", "pages": [26, 28, 29, 30] }]],
      "must_contain": ["etag", "304", "revalidation", "if-none-match"] },
    { "id": "T13", "type": "paraphrase", "q": "Why can't two threads safely add to the same variable at the same time?",
      "groups": [[{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [27, 28] }]],
      "must_contain": ["race condition", "x=x+6", "lock"] },

    { "id": "T14", "type": "compare", "q": "How does a circuit breaker differ from a bulkhead?",
      "groups": [[{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [34, 35, 36, 37] }],
                 [{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [38, 39, 40, 41] }]],
      "must_contain": ["circuit breaker", "bulkhead", "open", "closed", "pools", "threads"] },
    { "id": "T15", "type": "compare", "q": "What's the difference between a write-through cache and a write-behind cache?",
      "groups": [[{ "deck": "day09-caching.pdf", "pages": [12, 14, 16] }],
