      "must_contain": ["impractical", "expensive", "balancing act"] },
    { "id": "T2-11", "type": "paraphrase", "q": "What are the advantages of handing my code to the cloud provider to run on demand instead of managing machines myself?",
      "groups": [[{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [16] }]],
      "must_contain": ["serverless", "pay by usage", "lambda"] },
    { "id": "T2-12", "type": "paraphrase", "q": "Why can't I just compare the times on two different computers to work out which event happened first?",
