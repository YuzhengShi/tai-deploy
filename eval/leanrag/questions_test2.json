                 [{ "deck": "Day 2 Fundamentals.pdf", "pages": [2, 6, 8, 9] }]],
      "must_contain": ["monitoring", "observability"] },
    { "id": "T2-16", "type": "compare", "q": "What is the difference between latency and throughput?",
      "groups": [[{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [8] }, { "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [27] }, { "deck": "Day 2 Fundamentals.pdf", "pages": [23] }],
                 [{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [8] }, { "deck": "Day1 lecture ONLINE 2026.pdf", "pages": [12] }]],
      "must_contain": ["latency", "throughput"] },
    { "id": "T2-17", "type": "compare", "q": "How does an API gateway differ from a load balancer?",
      "groups": [[{ "deck": "Day 6 Sneaking up on Microservices!.pdf", "pages": [19, 20, 21, 22] }],
                 [{ "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [28] }, { "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [13] }]],
      "must_contain": ["api gateway", "load balancer"] },

    { "id": "T2-18", "type": "cross-deck", "q": "Where does the course explain how replicas keep a system available when a machine fails?",
      "groups": [[{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [10] }],
                 [{ "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [21] }],
                 [{ "deck": "Day 5 APIs and Load Balancers.pdf", "pages": [27, 4] }]],
      "must_contain": ["replicas", "replication", "availability", "single point of failure"] },
    { "id": "T2-19", "type": "cross-deck", "q": "Where does the course explain Redis and Memcached?",
      "groups": [[{ "deck": "Day 4 ACID 2PC and Consensus.pdf", "pages": [17] }],
                 [{ "deck": "day09-caching.pdf", "pages": [6, 7] }]],
      "must_contain": ["redis", "memcached"] },
    { "id": "T2-20", "type": "cross-deck", "q": "Where does the course explain why microservices commonly communicate over HTTP?",
      "groups": [[{ "deck": "Day3 More Fundamentals and Concurrency.pdf", "pages": [11] }],
                 [{ "deck": "day09-caching.pdf", "pages": [31] }]],
      "must_contain": ["http", "microservices"] }
  ]
